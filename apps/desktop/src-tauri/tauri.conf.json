{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MKV Orchestrator",
  "version": "0.1.0",
  "identifier": "com.mkvorchestrator.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../../web run build",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "MKV Orchestrator",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../src/MKVOrchestrator.App/Assets/MKVO_icon.png",
      "../../../src/MKVOrchestrator.App/Assets/MKVO_icon.ico"
    ],
    "shortDescription": "Inspect, rename, remux, and maintain MKV media libraries"
  }
}

